{
  // PREVIEW / STAGING ONLY — separate Worker, separate empty D1 and KV, no crons, no Stripe, no email. Never touches production member data.
  // Deploy: wrangler deploy --config wrangler.staging.jsonc   (secrets: MALCOLM_AI_KEY, JWT_SECRET set on this worker only)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxprime-ai-chef-staging",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true, // staging has no custom domain; workers.dev is its only address
  "preview_urls": false,
  "assets": { "directory": "../public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/r/*", "/m/*", "/.well-known/*", "/security.txt"] },
  "d1_databases": [{ "binding": "DB", "database_name": "luxprime-ai-chef-staging-db", "database_id": "92213243-d812-463b-a7b9-cec51286ce14", "migrations_dir": "migrations" }],
  "services": [{ "binding": "MALCOLM", "service": "malcolmai-live" }],
  "kv_namespaces": [{ "binding": "IMAGES", "id": "d19654e3843b4fe7a6fc4337db6eff77" }],
  "ai": { "binding": "AI" },
  "vars": { "AI_PROVIDER": "malcolm", "MALCOLM_AI_URL": "https://malcolmai-live.oliverluxthorley.workers.dev/", "MALCOLM_AI_MODE": "lattice", "AI_TIMEOUT_MS": "70000", "AI_RETRIES": "0", "IMAGE_PROVIDER": "none", "ADMIN_EMAILS": "", "TESTER_EMAILS": "staging-tester@aichef.test", "MAIL_FROM": "Malcolm · AIchef.food staging <malcolm@aichef.food>", "MAIL_REPLY_TO": "malcolm@aichef.food", "ASSISTANT_SYNC": "malcolm", "ASSISTANT_SYNC_DAILY": "100", "STAGING": "1", "CONTACT_DRY_RUN": "1" },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "persist": true } } // console output is redacted in src/logredact.js; query strings redacted via script settings (redact_query_string)
}
