// LOCAL ONLY: no remote bindings, no AI, no Stripe, no crons. npx wrangler dev -c wrangler.local.jsonc
{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "luxprime-ai-chef-local",
 "main": "src/index.js",
 "compatibility_date": "2025-09-01",
 "compatibility_flags": [
  "nodejs_compat"
 ],
 "workers_dev": false,
 "assets": {
  "directory": "../public",
  "binding": "ASSETS",
  "html_handling": "auto-trailing-slash",
  "not_found_handling": "404-page",
  "run_worker_first": [
   "/api/*",
   "/r/*",
   "/m/*"
  ]
 },
 "d1_databases": [
  {
   "binding": "DB",
   "database_name": "luxprime-ai-chef-db",
   "database_id": "local-preview",
   "migrations_dir": "migrations"
  }
 ],
 "kv_namespaces": [
  {
   "binding": "IMAGES",
   "id": "local-preview"
  }
 ],
 "vars": {
  "AI_PROVIDER": "none",
  "MALCOLM_AI_URL": "",
  "MALCOLM_AI_MODE": "lattice",
  "AI_TIMEOUT_MS": "70000",
  "AI_RETRIES": "0",
  "IMAGE_PROVIDER": "none",
  "ADMIN_EMAILS": "",
  "TESTER_EMAILS": "tester@example.com",
  "MAIL_FROM": "Malcolm · AIchef.food <malcolm@aichef.food>",
  "MAIL_REPLY_TO": "malcolm@aichef.food",
  "ASSISTANT_AI": "off"
 },
 "observability": {
  "enabled": true
 }
}