{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "luxprime-ai-chef",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false, // public traffic only via aichef.food (zone WAF, Bot Fight Mode, HSTS); verified 29 Oct nothing calls the workers.dev URL
  "preview_urls": false,
  "assets": { "directory": "../public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/r/*", "/m/*", "/.well-known/*", "/security.txt"] },
  "d1_databases": [{ "binding": "DB", "database_name": "luxprime-ai-chef-db", "database_id": "32cc614d-ea54-4188-8d50-f1c85c412a86", "migrations_dir": "migrations" }],
  "services": [{ "binding": "MALCOLM", "service": "malcolmai-live" }],
  "kv_namespaces": [{ "binding": "IMAGES", "id": "5c55cc965cd84e10b497323a7cc43181" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["17 3 * * *", "*/20 * * * *"] },
  "vars": { "AI_PROVIDER": "malcolm", "MALCOLM_AI_URL": "https://malcolmai-live.oliverluxthorley.workers.dev/", "MALCOLM_AI_MODE": "lattice", "AI_TIMEOUT_MS": "70000", "AI_RETRIES": "0", "IMAGE_PROVIDER": "none", "ADMIN_EMAILS": "oliverthorley@hotmail.co.uk", "TESTER_EMAILS": "test@luxprime.chef", "MAIL_FROM": "Malcolm · AIchef.food <malcolm@aichef.food>", "MAIL_REPLY_TO": "malcolm@aichef.food", "ASSISTANT_SYNC": "malcolm", "ASSISTANT_SYNC_DAILY": "300", "BUFFER_ORG_ID": "6ae1d230f1223d958c420338", "BUFFER_DAILY_CAP": "10" },
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true, "persist": true } } // console output is redacted in src/logredact.js; query strings redacted via script settings (redact_query_string)
  // Secrets (wrangler secret put / dashboard): MALCOLM_AI_KEY, JWT_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET,
  // STRIPE_PRICE_MONTHLY, STRIPE_PRICE_FAMILY, APP_URL (optional custom domain),
  // BUFFER_API_KEY (Buffer personal API key; drafts only — /api/admin/buffer/*; inactive until set)
  // RESEND_API_KEY (all site email via src/mailer.js; inactive until set — requires the aichef.food domain verified in Resend)
}
