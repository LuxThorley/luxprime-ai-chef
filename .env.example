# ---- Server ----
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Long random string (e.g. `openssl rand -hex 32`). REQUIRED in production.
JWT_SECRET=change-me
DB_PATH=./data/luxprime.db

# ---- AI layer ----
# AI_PROVIDER: none | openai | malcolm   (none = built-in offline recipe engine)
AI_PROVIDER=none
# OpenAI-compatible chat completions endpoint (OpenAI, Groq, Together, OpenRouter, Ollama, vLLM...)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
# Malcolm AI / Omni-Lattice endpoint (must accept OpenAI-style POST {model,messages} OR the native contract in README)
MALCOLM_AI_URL=https://malcolmai-live.oliverluxthorley.workers.dev/
MALCOLM_AI_KEY=
MALCOLM_AI_MODEL=malcolm-chef
MALCOLM_AI_MODE=lattice   # lattice = POST /v1/recipes on the Malcolm worker; openai | native also supported

# ---- Stripe (test keys first!) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring monthly GBP prices: Chef de Partie £5.00, Head Chef £8.00, Gastronomique £12.00, Magazine add-on £3.50
STRIPE_PRICE_CHEF_DE_PARTIE=
STRIPE_PRICE_HEAD_CHEF=
STRIPE_PRICE_GASTRONOMIQUE=
STRIPE_PRICE_MAGAZINE=
# Legacy fallbacks: STRIPE_PRICE_MONTHLY (-> Chef de Partie), STRIPE_PRICE_FAMILY (-> Gastronomique)

# ---- Plans (display placeholders) ----
FREE_SEARCHES=3
PRICE_CHEF_DE_PARTIE_LABEL=£5.00
PRICE_HEAD_CHEF_LABEL=£8.00
PRICE_GASTRONOMIQUE_LABEL=£12.00
PRICE_MAGAZINE_LABEL=£3.50
GASTRONOMIQUE_SEATS=5

# ---- Dish images for AI recipes (optional) ----
# IMAGE_PROVIDER: none | openai   (any OpenAI-compatible /images/generations endpoint)
IMAGE_PROVIDER=none
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024
IMAGE_CACHE_DIR=./data/img-cache
